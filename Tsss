import os
import shutil
import pandas as pd

# Détection optionnelle de Spark
try:
    from pyspark.sql import DataFrame as SparkDataFrame
    SPARK_AVAILABLE = True
except ImportError:
    SparkDataFrame = ()
    SPARK_AVAILABLE = False


def write_to_csv_auto(self, df_to_write, csv_file_name, row_threshold=500_000):
    """
    Writes a dataframe to CSV.
    - Uses pandas if row_count <= row_threshold
    - Uses Spark if row_count > row_threshold
    - Spark output is consolidated into a single CSV file
    - Includes validation checks

    :param df_to_write: pandas.DataFrame or pyspark.sql.DataFrame
    :param csv_file_name: final CSV file name
    :param row_threshold: row count threshold to switch to Spark
    :return: True if success, False otherwise
    """

    output_path = os.path.join(self.csv_dir, csv_file_name)
    temp_dir = output_path + "_tmp"

    try:
        # =========================
        # 1️⃣ Détection type + nombre de lignes
        # =========================
        if isinstance(df_to_write, pd.DataFrame):
            row_count = len(df_to_write)
            is_pandas = True

        elif SPARK_AVAILABLE and isinstance(df_to_write, SparkDataFrame):
            row_count = df_to_write.count()
            is_pandas = False

        else:
            raise TypeError("Unsupported dataframe type")

        self.logger.info(f"CSV row count detected: {row_count}")

        # =========================
        # 2️⃣ Écriture avec pandas
        # =========================
        if row_count <= row_threshold:
            self.logger.info("Using pandas to write CSV")

            if not is_pandas:
                self.logger.info("Converting Spark DataFrame to pandas")
                df_to_write = df_to_write.toPandas()

            df_to_write.to_csv(
                output_path,
                index=False,        # ❗ pas d’index parasite
                encoding="utf-8"
            )

        # =========================
        # 3️⃣ Écriture avec Spark (1 seul fichier)
        # =========================
        else:
            if not SPARK_AVAILABLE:
                raise RuntimeError("Spark required but pyspark is not installed")

            self.logger.info("Using Spark to write CSV (single file)")

            # Nettoyage ancien output temporaire
            if os.path.exists(temp_dir):
                shutil.rmtree(temp_dir)

            # Écriture Spark
            df_to_write.coalesce(1).write \
                .mode("overwrite") \
                .option("header", "true") \
                .csv(temp_dir)

            # Récupération du fichier part-*.csv
            part_file = next(
                f for f in os.listdir(temp_dir)
                if f.startswith("part-") and f.endswith(".csv")
            )

            shutil.move(
                os.path.join(temp_dir, part_file),
                output_path
            )

            # Suppression du dossier temporaire Spark
            shutil.rmtree(temp_dir)

        # =========================
        # 4️⃣ CHECKS DE VALIDATION
        # =========================
        if not os.path.exists(output_path):
            raise IOError("CSV file was not created")

        if os.path.getsize(output_path) == 0:
            raise IOError("CSV file is empty")

        self.logger.info(f"CSV successfully written: {output_path}")
        return True

    except Exception as e:
        self.logger.error("CSV generation failed", exc_info=True)
        return False
