export S3_KEY_PREFIX=my-bucket/prefix
export CSV_DIR=/tmp/csv




import os
import shutil
import pandas as pd

# Détection Spark optionnelle
try:
    from pyspark.sql import DataFrame as SparkDataFrame
    SPARK_AVAILABLE = True
except ImportError:
    SparkDataFrame = ()
    SPARK_AVAILABLE = False


def write_csv_and_upload_to_s3(
    self,
    df_to_write,
    csv_file_name,
    id,
    file_id,
    s3_client,
    row_threshold=500_000
):
    """
    Génère un CSV (pandas ou spark), l'upload sur S3 et vérifie le SHA256.

    :param df_to_write: pandas.DataFrame ou pyspark.sql.DataFrame
    :param csv_file_name: ex: "export.csv"
    :param id: identifiant métier
    :param file_id: identifiant fichier
    :param s3_client: instance du client S3 (import direct)
    :param row_threshold: seuil lignes pandas / spark
    """

    # Variables d'environnement
    s3_prefix = os.environ["S3_KEY_PREFIX"]
    csv_dir = os.environ["CSV_DIR"]

    output_path = os.path.join(csv_dir, csv_file_name)
    temp_dir = output_path + "_tmp"

    # Key S3 finale (CSV uniquement)
    s3_key = f"{s3_prefix}/{id}/{file_id}/{csv_file_name}"

    try:
        # =========================
        # 1️⃣ Détection type + nombre de lignes
        # =========================
        if isinstance(df_to_write, pd.DataFrame):
            row_count = len(df_to_write)
            is_pandas = True

        elif SPARK_AVAILABLE and isinstance(df_to_write, SparkDataFrame):
            row_count = df_to_write.count()
            is_pandas = False

        else:
            raise TypeError("Unsupported dataframe type")

        self.logger.info(f"CSV row count detected: {row_count}")

        # =========================
        # 2️⃣ Écriture CSV avec pandas
        # =========================
        if row_count <= row_threshold:
            self.logger.info("Using pandas to write CSV")

            if not is_pandas:
                self.logger.info("Converting Spark DataFrame to pandas")
                df_to_write = df_to_write.toPandas()

            df_to_write.to_csv(
                output_path,
                index=False,
                encoding="utf-8"
            )

        # =========================
        # 3️⃣ Écriture CSV avec Spark (1 seul fichier)
        # =========================
        else:
            if not SPARK_AVAILABLE:
                raise RuntimeError("Spark required but pyspark not installed")

            self.logger.info("Using Spark to write CSV (single file)")

            if os.path.exists(temp_dir):
                shutil.rmtree(temp_dir)

            df_to_write.coalesce(1).write \
                .mode("overwrite") \
                .option("header", "true") \
                .csv(temp_dir)

            part_file = next(
                f for f in os.listdir(temp_dir)
                if f.startswith("part-") and f.endswith(".csv")
            )

            shutil.move(os.path.join(temp_dir, part_file), output_path)
            shutil.rmtree(temp_dir)

        # =========================
        # 4️⃣ Checks locaux CSV
        # =========================
        if not os.path.exists(output_path):
            raise IOError("CSV file was not created")

        if os.path.getsize(output_path) == 0:
            raise IOError("CSV file is empty")

        # =========================
        # 5️⃣ Upload CSV sur S3 + SHA256
        # =========================
        self.logger.info(f"Uploading CSV to S3 with key: {s3_key}")

        with open(output_path, "rb") as f:
            file_content = f.read()

        s3_client.upload_bytes(file_content, key=s3_key)

        local_sha256 = s3_client.compute_sha256_bytes(file_content)

        if not s3_client.verify_sha256_against_object(
            key=s3_key,
            expected_sha256=local_sha256
        ):
            self.logger.error("SHA256 checksum does not match after CSV upload")
            from flask import abort
            abort(415)

        self.logger.info("CSV uploaded successfully and SHA256 verified")

        return {
            "s3_key": s3_key,
            "row_count": row_count
        }

    except Exception as e:
        self.logger.error(f"Failed to write/upload CSV to S3: {e}", exc_info=True)
        from flask import abort
        abort(415)

    finally:
        # =========================
        # 6️⃣ Nettoyage local
        # =========================
        try:
            if os.path.exists(output_path):
                os.remove(output_path)
            if os.path.exists(temp_dir):
                shutil.rmtree(temp_dir)
        except Exception as e:
            self.logger.error(f"Failed to delete temp CSV files: {e}")
