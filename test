import os
import logging

from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker, scoped_session, declarative_base

# Base ORM partagée pour tous les modèles
Base = declarative_base()

_engine = None
SessionLocal = None


def _build_oracle_url() -> str:
    """
    Construit l'URL de connexion SQLAlchemy pour Oracle (driver oracledb, mode thin).
    Format : oracle+oracledb://user:pwd@host:port/?service_name=SERVICE
    """
    user = os.getenv("ORACLE_USER")
    password = os.getenv("ORACLE_PASSWORD")
    host = os.getenv("ORACLE_HOST", "localhost")
    port = os.getenv("ORACLE_PORT", "1521")
    service = os.getenv("ORACLE_SERVICE")

    if not all([user, password, host, port, service]):
        raise RuntimeError(
            "Variables d'environnement Oracle manquantes : "
            "ORACLE_USER, ORACLE_PASSWORD, ORACLE_HOST, ORACLE_PORT, ORACLE_SERVICE"
        )

    return f"oracle+oracledb://{user}:{password}@{host}:{port}/?service_name={service}"


def init_engine(app=None):
    """
    Initialise l'engine SQLAlchemy global + la Session ORM (SessionLocal).

    À appeler une seule fois, typiquement dans create_app().
    """
    global _engine, SessionLocal

    if _engine is not None:
        # Déjà initialisé
        return _engine

    database_url = _build_oracle_url()

    # Niveau de log (optionnel)
    log_level_str = os.getenv("LOG_LEVEL", "INFO").upper()
    log_level = getattr(logging, log_level_str, logging.INFO)

    _engine = create_engine(
        database_url,
        echo=False,          # True pour debug SQL, False en prod
        pool_pre_ping=True,  # Vérifie la connexion avant usage
        # Exemple de paramètres de pool si besoin :
        # pool_size=5,
        # max_overflow=10,
        # pool_timeout=30,
    )

    SessionLocal = scoped_session(
        sessionmaker(
            bind=_engine,
            autoflush=False,
            autocommit=False,
            expire_on_commit=False,
        )
    )

    # Log SQLAlchemy (optionnel)
    logging.getLogger("sqlalchemy.engine").setLevel(log_level)

    # Enregistrement du teardown Flask si app fournie
    if app is not None:
        register_db_handlers(app)

    return _engine


def register_db_handlers(app):
    """
    Enregistre les handlers Flask pour fermer la session à la fin de chaque requête.
    À appeler depuis create_app une fois l'engine initialisé.
    """

    @app.teardown_appcontext
    def remove_session(exception=None):
        if SessionLocal is not None:
            SessionLocal.remove()


def get_db():
    """
    Dépendance type "context manager" :

        from api.extensions import get_db

        with next(get_db()) as db:
            ...
    """
    if SessionLocal is None:
        init_engine()
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


def get_engine():
    """
    Récupérer l'engine brut si besoin (pour des requêtes SQL directes).
    """
    if _engine is None:
        init_engine()
    return _engine
EOF

