import logging
from logging.handlers import RotatingFileHandler

# ...

# Initialize Logger ####
logname = os.path.basename(app.config["LOG_FILENAME"])
logpath = os.path.join(app.config["LOG_DIRECTORY"], logname)

handler = RotatingFileHandler(
    logpath,
    maxBytes=app.config["LOG_MAX_SIZE"],
    backupCount=app.config["LOG_NB_BACKUP"],
)

formatter = logging.Formatter(
    "%(asctime)s [%(process)d] [%(levelname)s] %(name)s - %(message)s"
)
handler.setFormatter(formatter)

# On nettoie d’abord les handlers existants pour éviter les doublons
app.logger.handlers.clear()
app.logger.addHandler(handler)
app.logger.setLevel(app.config["LOG_LEVEL"])
app.logger.propagate = False  # pour ne pas remonter au root et doubler les logs

app.logger.info("=== Application démarrée ===")
app.logger.info(f"{app.application_name} {app.application_version}")
