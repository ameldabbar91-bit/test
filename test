cat << 'EOF' > tests/integration/test_health_route.py
import pytest

@pytest.mark.integration
def test_health_live(client):
    resp = client.get("/integrator/v1/health/live")
    assert resp.status_code == 200
    assert isinstance(resp.get_json(), dict)

@pytest.mark.integration
def test_health_ready(client):
    resp = client.get("/integrator/v1/health/ready")
    assert resp.status_code in (200, 503)
EOF


###########################################################
# FUNCTIONAL TESTS
###########################################################
cat << 'EOF' > tests/functional/test_file_upload_flow.py
import os
import io
import pytest

@pytest.mark.functional
@pytest.mark.skipif(
    os.getenv("RUN_FUNCTIONAL_TESTS") != "1",
    reason="RUN_FUNCTIONAL_TESTS != 1 — test fonctionnel désactivé"
)
def test_file_upload_flow(client):
    data = {
        "file": (io.BytesIO(b"hello world"), "test.txt"),
    }
    resp = client.post(
        "/integrator/v1/files",
        data=data,
        content_type="multipart/form-data",
    )
    assert resp.status_code in (200, 201)
EOF

echo "✅ Tous les fichiers tests ont été générés avec succès !"
