[pytest]
testpaths = tests
python_files = test_*.py
python_classes = Test*
python_functions = test_*

addopts =
    -vv
    --disable-warnings
    --strict-markers
    --cov=api
    --cov-report=term-missing
    --flake8          # <— ICI on dit à pytest de lancer flake8

markers =
    unit: tests unitaires
    integration: tests d’intégration
    functional: tests fonctionnels (S3, DB, etc.)
    gunicorn: tests spécifiques à Gunicorn
    slow: tests lents

filterwarnings =
    ignore::DeprecationWarning
    ignore::PendingDeprecationWarning

norecursedirs =
    virtual
    tmp
    logs
    run

# ----------- CONFIG FLAKE8 ------------------
[flake8]
max-line-length = 120
exclude =
    virtual,
    tmp,
    logs,
    run,
    __pycache__,
    .git,
    .tox
ignore =
    E203,  # slicing spacing (compat black)
    W503   # line break before binary operator
