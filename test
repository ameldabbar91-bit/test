
#!/bin/bash

set -e

echo "📁 Création de l'arborescence complète du dossier tests..."

###########################################################
# ARBORESCENCE
###########################################################
mkdir -p tests/unit/helpers
mkdir -p tests/unit/services
mkdir -p tests/unit/infra
mkdir -p tests/integration
mkdir -p tests/functional

echo "# package init" > tests/__init__.py
