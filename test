cat > "$PROJECT_ROOT/api/app.py" << 'EOF'
from flask import Flask

from api.extensions import init_engine, register_db_handlers, get_engine
from api.models import Base
from api.routes.health import health_bp


def create_app():
    app = Flask(__name__)

    # 1. Init engine + session
    init_engine(app)
    register_db_handlers(app)

    # 2. (Optionnel) Création des tables en DEV uniquement
    #    À ne pas faire en prod, préférer des migrations (Alembic).
    with app.app_context():
        engine = get_engine()
        Base.metadata.create_all(bind=engine)

    # 3. Enregistrer les blueprints
    app.register_blueprint(health_bp, url_prefix="/api")

    return app


# Pour lancer avec : python -m api.app
if __name__ == "__main__":
    app = create_app()
    app.run(debug=True)
EOF

