import pytest

from api.extensions import init_engine, get_engine, SessionLocal
from api.models import User, Base


@pytest.mark.integration
def test_db_connect_and_select_dual():
    """
    Test d'intégration simple : vérifie qu'on peut se connecter à Oracle
    et exécuter un SELECT 1 FROM dual.
    """
    init_engine()
    engine = get_engine()

    with engine.connect() as conn:
        result = conn.execute("SELECT 1 FROM dual")
        row = result.fetchone()

    assert row is not None
    # Suivant les drivers, row[0] peut être 1 ou '1'
    assert str(row[0]) == "1"


@pytest.mark.integration
def test_db_can_insert_user():
    """
    Test d'intégration ORM :
    - crée les tables (si pas déjà créé)
    - insère un User
    - le relit
    """
    init_engine()
    engine = get_engine()

    # Création des tables pour le test (en général, on le fait dans un setup dédié)
    Base.metadata.create_all(bind=engine)

    db = SessionLocal()
    try:
        user = User(
            email="integration@test.com",
            first_name="Int",
            last_name="Test",
            is_active=True,
        )
        db.add(user)
        db.commit()

        # Recharge l'utilisateur
        u = db.query(User).filter_by(email="integration@test.com").first()
        assert u is not None
        assert u.email == "integration@test.com"
        assert u.is_active is True
    finally:
        db.rollback()
        db.close()
EOF

