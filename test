# test_gunicorn_conf.py
cat << 'EOF' > tests/unit/infra/test_gunicorn_conf.py
import importlib
import pytest

@pytest.mark.unit
@pytest.mark.gunicorn
def test_gunicorn_conf():
    try:
        conf = importlib.import_module("conf.gunicorn_conf")
    except Exception:
        pytest.skip("conf/gunicorn_conf.py non trouvé")
    
    assert hasattr(conf, "bind")
    assert hasattr(conf, "workers")
    assert isinstance(conf.bind, str)
EOF


