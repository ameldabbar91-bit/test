import os
import oracledb
import logging
from flask_sqlalchemy import SQLAlchemy
from sqlalchemy import create_engine, text
from flask import current_app

# Initialisation du journal
logger = logging.getLogger(__name__)

# Initialisation de SQLAlchemy
db = SQLAlchemy()

def init_sqlalchemy(app=None):
    if app is None:
        app = current_app
    
    # --- Initialiser le client Oracle ---
    # IMPORTANT: Supprime ou commente cette ligne si tu n'as pas les libs Oracle client
    # oracledb.init_oracle_client()
    
    # --- Construction de l'URL SQLAlchemy ---
    # Lire les variables d'environnement
    user = os.getenv("ORACLE_USER")
    password = os.getenv("ORACLE_PASSWORD")
    host = os.getenv("ORACLE_HOST")
    port = os.getenv("ORACLE_PORT")
    service_name = os.getenv("ORACLE_SERVICE")
    
    # Vérification des informations de connexion
    if not user or not password or not service_name or not host or not port:
        raise RuntimeError(
            f"Configuration DB manquante: "
            f"HOST: {host}, PORT: {port}, "
            f"SERVICE_NAME: {service_name}, USER: {user}"
        )
    
    # **CORRECTION ICI** - Format correct du DSN Oracle
    # Option 1: Avec Easy Connect (plus simple)
    dsn = f"{host}:{port}/{service_name}"
    
    # Option 2: Avec DSN complet (si besoin)
    # dsn = f"(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST={host})(PORT={port}))(CONNECT_DATA=(SERVICE_NAME={service_name})))"
    
    # URL SQLAlchemy - **UTILISE 'oracledb' PAS 'oracle'**
    db_url = f"oracledb://{user}:{password}@{dsn}"
    
    logger.info(f"Connexion à Oracle: {host}:{port}/{service_name}")
    
    # --- Pool de connexions SQLAlchemy ---
    pool_size = int(os.getenv("DB_POOL_SIZE", "5"))
    max_overflow = int(os.getenv("DB_MAX_OVERFLOW", "10"))
    pool_timeout = int(os.getenv("DB_POOL_TIMEOUT", "30"))
    pool_recycle = int(os.getenv("DB_POOL_RECYCLE", "1800"))
    
    engine_options = {
        "pool_pre_ping": True,  # Vérifie la connexion avant utilisation
        "pool_size": pool_size,
        "max_overflow": max_overflow,
        "pool_timeout": pool_timeout,
        "pool_recycle": pool_recycle,
        # Options spécifiques Oracle
        "connect_args": {
            "encoding": "UTF-8",
            "nencoding": "UTF-8"
        }
    }
    
    # --- Configuration de Flask / SQLAlchemy ---
    app.config["SQLALCHEMY_DATABASE_URI"] = db_url
    app.config["SQLALCHEMY_TRACK_MODIFICATIONS"] = False
    app.config["SQLALCHEMY_ENGINE_OPTIONS"] = engine_options
    
    # Initialisation de SQLAlchemy avec l'application Flask
    db.init_app(app)
    
    # Test de connexion
    try:
        with app.app_context():
            with db.engine.connect() as connection:
                result = connection.execute(text("SELECT 1 FROM DUAL"))
                logger.info("✅ Connexion Oracle réussie")
    except Exception as e:
        logger.error(f"❌ Erreur de connexion Oracle: {str(e)}")
        raise
